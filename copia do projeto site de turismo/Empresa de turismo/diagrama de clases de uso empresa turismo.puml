@startuml diagrama empresa de turismo/site de viagens
left to right direction
' definição de atores
actor "cliente"
actor "banco de dados" 
' fronteiras de sistema
rectangle "sistema de turismo" {
  ' definição de casos de uso
  usecase "login" as UC1
  usecase "consultar reservas" as UC2
  usecase "listas aereas" as UC3
  usecase "filtro" as UC4
  usecase "comprar pacote" as UC5
  usecase "gerenciar reservas" as UC6
  usecase "gerenciar pacotes" as UC7

  ' relacionamentos entre casos de uso
    UC1 -.> UC2 : <<extend>>
    UC2 -.> UC3 : <<include>>
    UC4 -.> UC2 : <<extend>>
    UC2 -.> UC5 : <<extend>>
    UC7 -.> UC6 : <<include>>
    UC5 -[hidden]down-> UC7
    UC6 -.> UC2 : <<include>>


}

' associação entre atores e casos de uso
cliente --> UC1
UC7 --> "banco de dados"
@enduml